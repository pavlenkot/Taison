# ---------- Supabase ----------
# Панель Supabase → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
# service_role — тільки на сервері, ніколи не потрапляє в браузер
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ---------- AI ----------
# Який рушій розбирає чеки: claude | gemini
AI_PROVIDER=gemini

# Anthropic (потрібен, якщо AI_PROVIDER=claude)
ANTHROPIC_API_KEY=sk-ant-...
# Необов'язково. Типово claude-opus-5 — найточніший.
# Дешевша приблизно в 5 разів альтернатива: claude-haiku-4-5
CLAUDE_MODEL=claude-opus-5

# Google (потрібен, якщо AI_PROVIDER=gemini)
GEMINI_API_KEY=AIza...
GEMINI_MODEL=gemini-2.5-flash

# ---------- Швидка команда iOS ----------
# Довільний довгий рядок; той самий вписати у Швидку команду.
# Згенерувати: openssl rand -hex 32
INGEST_TOKEN=
# E-mail власника: до кого прив'язувати надіслане Швидкою командою
INGEST_OWNER_EMAIL=
