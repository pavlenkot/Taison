# ---------- Supabase ----------
# Панель Supabase → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
# service_role — тільки на сервері, ніколи не потрапляє в браузер
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ---------- AI ----------
# Який рушій розбирає чеки: claude | gemini | openrouter
AI_PROVIDER=gemini

# Anthropic (потрібен, якщо AI_PROVIDER=claude)
ANTHROPIC_API_KEY=sk-ant-...
# Необов'язково. Типово claude-opus-5 — найточніший.
# Дешевша приблизно в 5 разів альтернатива: claude-haiku-4-5
CLAUDE_MODEL=claude-opus-5

# OpenRouter (потрібен, якщо AI_PROVIDER=openrouter)
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your-key-here
# Повна назва моделі так, як її пише OpenRouter: постачальник/модель
OPENROUTER_MODEL=

# Google (потрібен, якщо AI_PROVIDER=gemini)
GEMINI_API_KEY=AIza...
GEMINI_MODEL=gemini-2.5-flash

# ---------- Швидка команда iOS ----------
# Довільний довгий рядок; той самий вписати у Швидку команду.
# Згенерувати: openssl rand -hex 32
INGEST_TOKEN=
# E-mail власника: до кого прив'язувати надіслане Швидкою командою
INGEST_OWNER_EMAIL=

# ---------- Google Диск ----------
# Ті самі значення, що вписані в Supabase → Authentication → Providers → Google.
# Створюються в Google Cloud Console → Credentials → OAuth client ID (Web).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Ключ, яким шифрується refresh-токен Google перед записом у базу.
# Рівно 64 шістнадцяткові символи. Згенерувати: openssl rand -hex 32
# Втратите цей ключ — доведеться підключити Диск заново.
TOKEN_ENCRYPTION_KEY=

# ---------- Копія за розкладом ----------
# Той самий рядок Vercel Cron надсилає у заголовку Authorization. Згенерувати: openssl rand -hex 32
CRON_SECRET=

# ---------- Нагадування (веб-push) ----------
# Власні ключі, сторонніх сервісів не потрібно. Згенерувати:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# Публічний ключ і так потрапляє в браузер — префікс NEXT_PUBLIC_ обов'язковий.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Приватний ключ секретний: ним підписуються сповіщення від вашого імені.
VAPID_PRIVATE_KEY=
# Адреса, куди push-сервіс поскаржиться на застосунок. Якщо не вказати,
# береться INGEST_OWNER_EMAIL. Якщо Швидку команду не налаштовуєте —
# впишіть пошту тут, інакше сповіщення лишаться вимкненими.
VAPID_SUBJECT=
